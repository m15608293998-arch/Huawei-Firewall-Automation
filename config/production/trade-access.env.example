# Copy this file to /etc/trade-access/trade-access.env, replace every
# REPLACE_* value, then set owner root:ansiblerun and mode 0640.

TRADE_ACCESS_API_AUTH_ENABLED=true

TRADE_ACCESS_API_DATABASE_PATH=/var/lib/trade-access/api/jobs.sqlite3
TRADE_ACCESS_API_RUNNER_PRIVATE_DATA_DIR=/var/lib/trade-access/runner
TRADE_ACCESS_API_JOB_TMP_ROOT=/var/lib/trade-access/jobs

# Execution budgets in seconds; use the same values for API and worker.
# The job budget starts at first claim and survives retries and restarts.
TRADE_ACCESS_API_JOB_TIMEOUT_SECONDS=1800
TRADE_ACCESS_API_RUNNER_TIMEOUT_SECONDS=900
TRADE_ACCESS_API_SNAPSHOT_TIMEOUT_SECONDS=300
TRADE_ACCESS_API_RUNNER_LOCK_TIMEOUT_SECONDS=10
# Includes the first baseline query; independent of mutation attempts.
TRADE_ACCESS_API_PRECHECK_MAX_ATTEMPTS=3

# Worker readiness: timeout must exceed twice the heartbeat interval.
TRADE_ACCESS_API_WORKER_HEARTBEAT_INTERVAL_SECONDS=2
TRADE_ACCESS_API_WORKER_HEARTBEAT_TIMEOUT_SECONDS=15
# Polling/preparation budget; device stages use the execution budgets above.
TRADE_ACCESS_API_WORKER_PROGRESS_TIMEOUT_SECONDS=60

# One all-firewall query runs per API process; identical requests can share it.
TRADE_ACCESS_API_QUERY_MAX_WAITERS=16
TRADE_ACCESS_API_QUERY_WAIT_TIMEOUT_SECONDS=10

TRADE_ACCESS_API_KEYCLOAK_SERVER_URL=https://REPLACE_KEYCLOAK_HOST
TRADE_ACCESS_API_KEYCLOAK_REALM=trade-access
TRADE_ACCESS_API_KEYCLOAK_CLIENT_ID=trade-access-api

TRADE_ACCESS_API_KEYCLOAK_BROWSER_CLIENT_ID=trade-access-portal
TRADE_ACCESS_API_KEYCLOAK_BROWSER_SCOPE="openid profile email"
TRADE_ACCESS_API_KEYCLOAK_ADMIN_BROWSER_CLIENT_ID=trade-access-admin-portal
TRADE_ACCESS_API_KEYCLOAK_ADMIN_BROWSER_SCOPE="openid profile email"

TRADE_ACCESS_API_KEYCLOAK_OFFLINE_CLIENT_ID=trade-access-offline
TRADE_ACCESS_API_KEYCLOAK_OFFLINE_CLIENT_SECRET="REPLACE_OFFLINE_CLIENT_SECRET"
TRADE_ACCESS_API_KEYCLOAK_OFFLINE_SCOPE="openid profile offline_access"
TRADE_ACCESS_API_OFFLINE_API_KEY_TOKEN_ENCRYPTION_KEY="REPLACE_STABLE_ENCRYPTION_KEY"

TRADE_ACCESS_API_KEYCLOAK_USER_ROLE=trade-access-user
TRADE_ACCESS_API_KEYCLOAK_ADMIN_ROLE=trade-access-admin
TRADE_ACCESS_API_KEYCLOAK_ADMIN_CLIENT_ID=trade-access-provisioner
TRADE_ACCESS_API_KEYCLOAK_ADMIN_CLIENT_SECRET="REPLACE_PROVISIONING_CLIENT_SECRET"

TRADE_ACCESS_API_KEYCLOAK_HTTP_TIMEOUT_SECONDS=5
TRADE_ACCESS_API_KEYCLOAK_JWKS_CACHE_SECONDS=300
# Shared refresh cooldown per API process, including failed refreshes.
# A newly rotated kid may require a retry after this interval.
TRADE_ACCESS_API_KEYCLOAK_JWKS_REFRESH_MIN_INTERVAL_SECONDS=10

# Uncomment when Keycloak uses an internal CA.
# TRADE_ACCESS_API_KEYCLOAK_CA_CERT=/etc/trade-access/internal-ca.pem
